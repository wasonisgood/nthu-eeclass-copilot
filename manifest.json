{
  "manifest_version": 3,
  "name": "NTHU eeclass Copilot｜清大數位學習全能助手",
  "version": "1.4.1",
  "description": "清大 eeclass 與 OAuth 全能助手：CNN 驗證碼自動登入、AES-GCM 憑證保險箱、Google 日曆作業事件即時同步、課程教材自動同步歸檔與助教工作台",
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "identity",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://oauth.ccxp.nthu.edu.tw/*",
    "https://eeclass.nthu.edu.tw/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo.png"
  },
  "action": {
    "default_title": "eeclass 快速設定",
    "default_popup": "options.html?mode=popup"
  },
  "side_panel": {
    "default_path": "options.html?mode=sidepanel"
  },
  "options_ui": {
    "page": "options.html?mode=full",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.lib.nthu.edu.tw/*",
        "https://idm.nthu.ust.edu.tw/*"
      ],
      "run_at": "document_idle",
      "js": [
        "library-captcha-model.js",
        "library-captcha.js",
        "library-autologin.js"
      ]
    },
    {
      "matches": [
        "https://eeclass.nthu.edu.tw/"
      ],
      "run_at": "document_idle",
      "js": [
        "eeclass-home-autologin.js"
      ]
    },
    {
      "matches": [
        "https://oauth.ccxp.nthu.edu.tw/*"
      ],
      "run_at": "document_start",
      "js": [
        "decaptcha.model.js",
        "decaptcha.js",
        "content.js"
      ]
    },
    {
      "matches": [
        "https://eeclass.nthu.edu.tw/*"
      ],
      "run_at": "document_idle",
      "js": [
        "course-downloader.js",
        "calendar-content.js"
      ],
      "css": [
        "course-downloader.css"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://eeclass.nthu.edu.tw/*",
      "https://oauth.ccxp.nthu.edu.tw/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "swagger.html",
        "swagger.css",
        "swagger.js",
        "swagger-spec.json",
        "swagger-spec.js",
        "consent.html",
        "consent.css",
        "consent.js",
        "setup-guide.html",
        "setup-guide.js",
        "api/eeclass-api.yaml",
        "assets/*",
        "vendor/swagger-ui/*"
      ],
      "matches": [
        "https://eeclass.nthu.edu.tw/*"
      ]
    }
  ]
}
